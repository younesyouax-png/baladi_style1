<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Products | Baladi Style</title>

    <link rel="stylesheet" href="/dashboard.css">

    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>


<body>


    <%- include("slidebar") %>


    <main class="content">


        <div class="products-section">


            <div class="products-section-header">

                <div>

                    <span>
                        STORE MANAGEMENT
                    </span>

                    <h1>
                        PRODUCTS
                    </h1>

                </div>


                <a
                    href="/add_product"
                    class="add-product"
                >
                    + ADD PRODUCT
                </a>

            </div>


            <% if (products.length === 0) { %>


                <div class="no-products">

                    <h2>
                        NO PRODUCTS
                    </h2>

                    <p>
                        You haven't added any products yet.
                    </p>

                    <a
                        href="/add_product"
                        class="add-product"
                    >
                        ADD YOUR FIRST PRODUCT
                    </a>

                </div>


            <% } else { %>


                <div class="products-list">


                    <% products.forEach((product, index) => { %>


                        <div class="product-row">


                            <!-- =================================
                                 PRODUCT IMAGE
                            ================================== -->

                            <div class="product-thumb">

                                <img
                                    src="<%= product.Image %>"
                                    alt="<%= product.name %>"
                                >

                            </div>


                            <!-- =================================
                                 PRODUCT DETAILS
                            ================================== -->

                            <div class="product-details">

                                <span class="product-number">
                                    PRODUCT <%= String(index + 1).padStart(2, "0") %>
                                </span>

                                <h2>
                                    <%= product.name %>
                                </h2>

                                <p>
                                    <%= product.category || "STREETWEAR" %>
                                </p>

                            </div>


                            <!-- =================================
                                 PRICE
                            ================================== -->

                            <div class="product-price">

                                <span>
                                    PRICE
                                </span>

                                <strong>
                                    <%= product.price %>
                                </strong>

                                <small>
                                    DA
                                </small>

                            </div>


                            <!-- =================================
                                 STOCK
                            ================================== -->

                            <div class="product-stock">


                                <!-- S -->

                                <div class="stock-item">

                                    <span>
                                        S
                                    </span>

                                    <strong>
                                        <%= product.quantity_S || 0 %>
                                    </strong>

                                </div>


                                <!-- M -->

                                <div class="stock-item">

                                    <span>
                                        M
                                    </span>

                                    <strong>
                                        <%= product.quantity_M || 0 %>
                                    </strong>

                                </div>


                                <!-- L -->

                                <div class="stock-item">

                                    <span>
                                        L
                                    </span>

                                    <strong>
                                        <%= product.quantity_L || 0 %>
                                    </strong>

                                </div>


                                <!-- XL -->

                                <div class="stock-item">

                                    <span>
                                        XL
                                    </span>

                                    <strong>
                                        <%= product.quantity_XL || 0 %>
                                    </strong>

                                </div>


                                <!-- 2XL -->

                                <div class="stock-item">

                                    <span>
                                        2XL
                                    </span>

                                    <strong>
                                        <%= product.quantity_2XL || 0 %>
                                    </strong>

                                </div>


                            </div>


                            <!-- =================================
                                 ACTION
                            ================================== -->

                            <div class="product-action">

                                <form
                                    action="/dashboard/delete_product/<%= product._id %>"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                                >

                                    <button
                                        type="submit"
                                        class="delete-product"
                                    >
                                        DELETE
                                    </button>

                                </form>

                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>


    </main>


</body>

</html>