    <script>


        /* =====================================
           CATEGORY FILTER
        ====================================== */

        const categoryButtons =
            document.querySelectorAll(".category-btn");


        const products =
            document.querySelectorAll(".shop-product");


        const productsCount =
            document.getElementById("productsCount");


        const noResults =
            document.getElementById("noResults");



        categoryButtons.forEach(button => {


            button.addEventListener("click", () => {


                // Remove active

                categoryButtons.forEach(btn => {

                    btn.classList.remove("active");

                });


                // Add active

                button.classList.add("active");


                // Selected category

                const selectedCategory =
                    button.dataset.category
                        .trim()
                        .toLowerCase();


                let visibleProducts = 0;



                // Filter

                products.forEach(product => {


                    const productCategory =
                        (product.dataset.category || "")
                            .trim()
                            .toLowerCase();



                    if (
                        selectedCategory === "all" ||
                        productCategory === selectedCategory
                    ) {


                        product.classList.remove("hidden");

                        visibleProducts++;


                    } else {


                        product.classList.add("hidden");


                    }

                });



                // Counter

                productsCount.textContent =
                    visibleProducts;



                // Empty state

                if (visibleProducts === 0) {

                    noResults.classList.add("show");

                } else {

                    noResults.classList.remove("show");

                }


            });


        });



        /* =====================================
           PRODUCT MODAL
        ====================================== */

        function openProductModal(
            id,
            name,
            price,
            description,
            Image,
            category,
            quantityS,
            quantityM,
            quantityL,
            quantityXL
        ) {


            // ===============================
            // PRODUCT INFORMATION
            // ===============================

            document.getElementById(
                "modalProductImage"
            ).src = Image;


            document.getElementById(
                "modalProductImage"
            ).alt = name;


            document.getElementById(
                "modalProductName"
            ).textContent = name;


            document.getElementById(
                "modalProductPrice"
            ).textContent = price + " DA";


            document.getElementById(
                "modalProductDescription"
            ).textContent = description;


            document.getElementById(
                "modalProductCategory"
            ).textContent =
                category
                    ? category.toUpperCase()
                    : "STREETWEAR";



            // ===============================
            // HIDDEN FORM DATA
            // ===============================

            document.getElementById(
                "orderProductId"
            ).value = id;


            document.getElementById(
                "orderProductName"
            ).value = name;


            document.getElementById(
                "orderProductPrice"
            ).value = price;



            // ===============================
            // RESET QUANTITY
            // ===============================

            const quantityInput =
                document.getElementById(
                    "orderQuantity"
                );


            quantityInput.value = 1;

            quantityInput.max = 1;



            // ===============================
            // UPDATE SIZES
            // ===============================

            updateSize(
                "sizeS",
                quantityS
            );


            updateSize(
                "sizeM",
                quantityM
            );


            updateSize(
                "sizeL",
                quantityL
            );


            updateSize(
                "sizeXL",
                quantityXL
            );



            // ===============================
            // SIZE CHANGE
            // ===============================

            const sizeInputs =
                document.querySelectorAll(
                    'input[name="size"]'
                );


            sizeInputs.forEach(input => {

                input.onchange = function () {


                    let maxQuantity = 1;


                    if (this.value === "S") {

                        maxQuantity =
                            Number(quantityS);

                    }


                    if (this.value === "M") {

                        maxQuantity =
                            Number(quantityM);

                    }


                    if (this.value === "L") {

                        maxQuantity =
                            Number(quantityL);

                    }


                    if (this.value === "XL") {

                        maxQuantity =
                            Number(quantityXL);

                    }


                    quantityInput.max =
                        maxQuantity;


                    quantityInput.value = 1;


                };

            });



            // ===============================
            // SHOW MODAL
            // ===============================

            document.getElementById(
                "productModal"
            ).classList.add("active");


            document.body.classList.add(
                "modal-open"
            );


        }



        /* =====================================
           UPDATE SIZE
        ====================================== */

        function updateSize(
            elementId,
            quantity
        ) {


            const element =
                document.getElementById(
                    elementId
                );


            const input =
                element.querySelector(
                    "input"
                );


            const status =
                element.querySelector(
                    "small"
                );


            quantity =
                Number(quantity);



            if (quantity > 0) {


                // AVAILABLE

                element.classList.remove(
                    "unavailable"
                );


                input.disabled = false;


                status.textContent =
                    "AVAILABLE";


            } else {


                // UNAVAILABLE

                element.classList.add(
                    "unavailable"
                );


                input.disabled = true;


                input.checked = false;


                status.textContent =
                    "UNAVAILABLE";


            }


        }



        /* =====================================
           CLOSE MODAL
        ====================================== */

        function closeProductModal() {


            document.getElementById(
                "productModal"
            ).classList.remove("active");


            document.body.classList.remove(
                "modal-open"
            );


        }



        /* =====================================
           ESC KEY
        ====================================== */

        document.addEventListener(
            "keydown",
            event => {


                if (event.key === "Escape") {

                    closeProductModal();

                }


            }
        );
