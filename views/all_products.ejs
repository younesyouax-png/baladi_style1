// ELEMENTS

const wilayaInput =
    document.getElementById("wilaya");

const quantityInput =
    document.getElementById("orderQuantity");

const addressField =
    document.getElementById("addressField");

const addressInput =
    document.getElementById("address");

const productPriceInput =
    document.getElementById("orderProductPrice");

const deliveryPriceInput =
    document.getElementById("deliveryPrice");

const totalPriceInput =
    document.getElementById("totalPrice");

const productTotal =
    document.getElementById("productTotal");

const deliveryTotal =
    document.getElementById("deliveryTotal");

const orderTotal =
    document.getElementById("orderTotal");


// NORMALIZE WILAYA

function normalizeWilaya(name) {

    return name
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

}


// FIND WILAYA

function getWilayaData(wilaya) {

    const normalized =
        normalizeWilaya(wilaya);

    for (const key in deliveryPrices) {

        if (
            normalizeWilaya(key) === normalized
        ) {
            return deliveryPrices[key];
        }

    }

    return null;

}


// GET DELIVERY PRICE

function getDeliveryPrice() {

    const wilaya =
        wilayaInput.value;

    const selectedMethod =
        document.querySelector(
            'input[name="deliveryMethod"]:checked'
        );

    if (!wilaya || !selectedMethod) {
        return 0;
    }

    const data =
        getWilayaData(wilaya);

    if (!data) {
        return 0;
    }

    if (
        selectedMethod.value === "Home Delivery"
    ) {
        return data.home;
    }

    if (
        selectedMethod.value === "Stop Desk"
    ) {
        return data.stopDesk;
    }

    return 0;

}


// UPDATE TOTAL

function updateTotal() {

    const price =
        parseFloat(productPriceInput.value) || 0;

    const quantity =
        parseInt(quantityInput.value) || 1;

    const delivery =
        getDeliveryPrice();

    const subtotal =
        price * quantity;

    const total =
        subtotal + delivery;


    productTotal.textContent =
        subtotal.toLocaleString("fr-DZ");

    deliveryTotal.textContent =
        delivery.toLocaleString("fr-DZ");

    orderTotal.textContent =
        total.toLocaleString("fr-DZ");


    deliveryPriceInput.value =
        delivery;

    totalPriceInput.value =
        total;

}


// DELIVERY METHOD

document
    .querySelectorAll(
        'input[name="deliveryMethod"]'
    )
    .forEach(function (radio) {

        radio.addEventListener(
            "change",
            function () {

                if (
                    this.value === "Home Delivery"
                ) {

                    addressField.style.display =
                        "block";

                    addressInput.required =
                        true;

                } else {

                    addressField.style.display =
                        "none";

                    addressInput.required =
                        false;

                    addressInput.value = "";

                }

                updateTotal();

            }
        );

    });


// WILAYA

wilayaInput.addEventListener(
    "input",
    updateTotal
);


// QUANTITY

quantityInput.addEventListener(
    "input",
    updateTotal
);


// INITIAL UPDATE

updateTotal();

