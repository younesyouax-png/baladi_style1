    <script>

        /* =====================================================
                           HERO SCROLL
        ====================================================== */

        const heroContent =
            document.querySelector(".hero_content");

        const hero =
            document.querySelector(".hero");


        if (heroContent && hero) {

            window.addEventListener("scroll", () => {

                const scroll =
                    window.scrollY;

                const heroHeight =
                    hero.offsetHeight;

                let opacity =
                    1 - (scroll / (heroHeight * 0.7));


                if (opacity < 0) {
                    opacity = 0;
                }


                heroContent.style.opacity =
                    opacity;


                heroContent.style.transform =
                    `translateY(${scroll * 0.25}px)`;

            });

        }


        /* =====================================================
                         PRODUCTS SLIDER
        ====================================================== */

        const productsGrid =
            document.querySelector(".products-grid");

        const nextButton =
            document.querySelector(".products-next");

        const prevButton =
            document.querySelector(".products-prev");


        if (
            productsGrid &&
            nextButton &&
            prevButton
        ) {

            nextButton.addEventListener(
                "click",
                () => {

                    productsGrid.scrollBy({

                        left:
                            productsGrid.clientWidth,

                        behavior:
                            "smooth"

                    });

                }
            );


            prevButton.addEventListener(
                "click",
                () => {

                    productsGrid.scrollBy({

                        left:
                            -productsGrid.clientWidth,

                        behavior:
                            "smooth"

                    });

                }
            );

        }


        /* =====================================================
                         MODAL ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById("productModal");

        const modalClose =
            document.getElementById("modalClose");

        const modalOverlay =
            document.getElementById("modalOverlay");

        const orderQuantity =
            document.getElementById("orderQuantity");

        const placeOrder =
            document.getElementById("placeOrder");


        /* =====================================================
                           STOCK DATA
        ====================================================== */

        let currentStock = {

            S: 0,
            M: 0,
            L: 0,
            XL: 0,
            "2XL": 0

        };


        /* =====================================================
                         OPEN PRODUCT MODAL
        ====================================================== */

        function openProductModal(button) {

            /* ================= PRODUCT DATA ================= */

            const id =
                button.dataset.id;

            const name =
                button.dataset.name;

            const price =
                Number(button.dataset.price) || 0;

            const description =
                button.dataset.description || "";

            const image =
                button.dataset.image || "";

            const category =
                button.dataset.category || "";


            /* ================= STOCK ================= */

            currentStock = {

                S:
                    Number(button.dataset.s) || 0,

                M:
                    Number(button.dataset.m) || 0,

                L:
                    Number(button.dataset.l) || 0,

                XL:
                    Number(button.dataset.xl) || 0,

                "2XL":
                    Number(button.dataset["2xl"]) || 0

            };


            /* ================= PRODUCT INFO ================= */

            document
                .getElementById("modalProductImage")
                .src = image;


            document
                .getElementById("modalProductImage")
                .alt = name;


            document
                .getElementById("modalProductName")
                .textContent = name;


            document
                .getElementById("modalProductPrice")
                .textContent =
                    price.toLocaleString("fr-DZ") + " DA";


            document
                .getElementById("modalProductDescription")
                .textContent = description;


            document
                .getElementById("modalProductCategory")
                .textContent =
                    category
                        ? category.toUpperCase()
                        : "STREETWEAR";


            /* =================================================
                              RESET FORM
            ================================================== */

            const orderForm =
                document.getElementById("orderForm");


            orderForm.reset();


            /* =================================================
                         SET PRODUCT DATA
            ================================================== */

            document
                .getElementById("orderProductId")
                .value = id;


            document
                .getElementById("orderProductName")
                .value = name;


            document
                .getElementById("orderProductPrice")
                .value = price;


            /* =================================================
                         RESET DELIVERY DATA
            ================================================== */

            document
                .getElementById("deliveryPrice")
                .value = 0;


            document
                .getElementById("totalPrice")
                .value = 0;


            /* =================================================
                           RESET DISPLAY
            ================================================== */

            document
                .getElementById("productTotal")
                .textContent = "0";


            document
                .getElementById("deliveryTotal")
                .textContent = "0";


            document
                .getElementById("orderTotal")
                .textContent = "0";


            /* =================================================
                           RESET ADDRESS
            ================================================== */

            addressField.style.display =
                "none";

            addressInput.required =
                false;

            addressInput.value =
                "";


            /* =================================================
                           RESET QUANTITY
            ================================================== */

            orderQuantity.value =
                "0";

            orderQuantity.min =
                "0";


            /* =================================================
                           UPDATE SIZES
            ================================================== */

            updateSize(
                "sizeS",
                "S"
            );

            updateSize(
                "sizeM",
                "M"
            );

            updateSize(
                "sizeL",
                "L"
            );

            updateSize(
                "sizeXL",
                "XL"
            );

            updateSize(
                "size2XL",
                "2XL"
            );


            /* =================================================
                       FIND FIRST AVAILABLE SIZE
            ================================================== */

            const firstAvailable =
                ["S", "M", "L", "XL", "2XL"].find(
                    size =>
                        currentStock[size] > 0
                );


            if (firstAvailable) {

                const radio =
                    document.querySelector(
                        `input[name="size"][value="${firstAvailable}"]`
                    );


                if (radio) {

                    radio.checked =
                        true;

                    updateQuantityLimit(
                        firstAvailable
                    );

                }

            } else {

                orderQuantity.value =
                    0;

                orderQuantity.max =
                    "";

                placeOrder.disabled =
                    true;

            }


            /* =================================================
                           UPDATE TOTAL
            ================================================== */

            updateTotal();


            /* =================================================
                            OPEN MODAL
            ================================================== */

            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.classList.add(
                "modal-open"
            );

        }


        /* =====================================================
                           UPDATE SIZE
        ====================================================== */

        function updateSize(
            elementId,
            size
        ) {

            const container =
                document.getElementById(elementId);


            const radio =
                container.querySelector(
                    'input[type="radio"]'
                );


            const status =
                container.querySelector("small");


            const stock =
                currentStock[size];


            if (stock <= 0) {

                radio.disabled =
                    true;

                radio.checked =
                    false;

                container.classList.add(
                    "unavailable"
                );


                status.textContent =
                    "SOLD OUT";

            } else {

                radio.disabled =
                    false;

                container.classList.remove(
                    "unavailable"
                );


                status.textContent =
                    stock + " AVAILABLE";

            }

        }


        /* =====================================================
                         SIZE CHANGE
        ====================================================== */

        document
            .querySelectorAll(
                'input[name="size"]'
            )
            .forEach(radio => {

                radio.addEventListener(
                    "change",
                    () => {

                        if (radio.checked) {

                            updateQuantityLimit(
                                radio.value
                            );

                            updateTotal();

                        }

                    }
                );

            });


        /* =====================================================
                      UPDATE QUANTITY LIMIT
        ====================================================== */

        function updateQuantityLimit(size) {

            const max =
                currentStock[size] || 0;


            orderQuantity.max =
                max;


            orderQuantity.value =
                0;


            if (max > 0) {

                placeOrder.disabled =
                    false;

            } else {

                placeOrder.disabled =
                    true;

            }


            updateTotal();

        }


        /* =====================================================
                       QUANTITY VALIDATION
        ====================================================== */

        orderQuantity.addEventListener(
            "input",
            () => {

                const selected =
                    document.querySelector(
                        'input[name="size"]:checked'
                    );


                if (!selected) {

                    updateTotal();

                    return;

                }


                const max =
                    currentStock[selected.value];


                const inputValue =
                    orderQuantity.value;


                // Allow the user to temporarily empty the field

                if (inputValue === "") {

                    updateTotal();

                    return;

                }


                let value =
                    Number(inputValue);


                // Prevent invalid values

                if (isNaN(value)) {

                    orderQuantity.value = "";

                    updateTotal();

                    return;

                }


                // Only limit the maximum

                if (value > max) {

                    value = max;

                }


                orderQuantity.value =
                    value;


                updateTotal();

            }
        );


        /* =====================================================
                          CLOSE MODAL
        ====================================================== */

        function closeProductModal() {

            modal.classList.remove(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.classList.remove(
                "modal-open"
            );

        }


        /* CLOSE BUTTON */

        modalClose.addEventListener(
            "click",
            closeProductModal
        );


        /* OVERLAY */

        modalOverlay.addEventListener(
            "click",
            closeProductModal
        );


        /* ESC */

        document.addEventListener(
            "keydown",
            event => {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeProductModal();

                }

            }
        );


        /* =====================================================
                         PRODUCT BUTTONS
        ====================================================== */

        document
            .querySelectorAll(
                ".product-view, .quick-view"
            )
            .forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        openProductModal(
                            button
                        );

                    }
                );

            });


