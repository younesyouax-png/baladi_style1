<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Baladi Style</title>

    <!-- ================= FONTS ================= -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Rubik:ital,wght@0,300..900;1,300..900&family=Sora:wght@100..800&display=swap"
        rel="stylesheet"
    >

    <!-- ================= ICONS ================= -->

    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=search,add_shopping_cart"
    >

    <!-- ================= CSS ================= -->

    <link rel="stylesheet" href="/landing.css">
    <link rel="stylesheet" href="/product_card.css">
    <link rel="stylesheet" href="/all_products.css">

</head>

<body>

    <!-- =====================================================
                         NAVBAR
    ====================================================== -->

    <nav class="nav">

        <div class="logo_container">

            <a href="#hero">

                <img
                    src="/logo.jpg"
                    alt="Baladi Style Logo"
                >

            </a>

        </div>


        <ul class="nav_links">

            <li>
                <a href="#hero">
                    Home
                </a>
            </li>

            <li>
                <a href="#products">
                    New Products
                </a>
            </li>

            <li>
                <a href="/products">
                    All products
                </a>
            </li>

            <li>
                <a href="#feedbacks">
                    Feedbacks
                </a>
            </li>

            <li>
                <a href="#about">
                    About
                </a>
            </li>

        </ul>


        <div class="nav_icons">

            <a id="menu">

                <img
                    id="close"
                    src="/menu.svg"
                    alt=""
                >

            </a>

        </div>

    </nav>


    <!-- =====================================================
                         MOBILE MENU
    ====================================================== -->

    <div id="hamburger">

        <ul class="ham_links">

            <li>
                <a href="#hero">
                    Home
                </a>
            </li>

            <li>
                <a href="#products">
                    New Products
                </a>
            </li>

            <li>
                <a href="/products">
                    All products
                </a>
            </li>

            <li>
                <a href="#feedbacks">
                    Feedbacks
                </a>
            </li>

            <li>
                <a href="#about">
                    About
                </a>
            </li>

        </ul>

    </div>


    <main>

        <!-- =====================================================
                              HERO
        ====================================================== -->

        <section
            class="hero"
            id="hero"
        >

            <div class="hero_overlay"></div>


            <div class="hero_content">

                <h1>
                    OWN<br>

                    <span>
                        THE STREET
                    </span>

                </h1>


                <p class="hero_description">

                    Elevate your everyday style with pieces
                    made for those who stand out.

                </p>


                <a
                    href="#products"
                    class="shop_btn"
                >

                    SHOP NOW

                    <span>
                        →
                    </span>

                </a>

            </div>


            <div class="scroll_indicator">

                <span></span>

                SCROLL TO EXPLORE

            </div>

        </section>


        <!-- =====================================================
                         PRODUCTS SECTION
        ====================================================== -->

        <section
            class="products-section"
            id="products"
        >

            <div class="products-header">

                <div>

                    <span class="products-label">
                        LATEST DROP
                    </span>


                    <h1>

                        FRESH

                        <span>
                            FROM
                        </span>

                        <br>

                        THE STREET

                    </h1>

                </div>


                <a
                    href="/products"
                    class="view-all"
                >

                    VIEW ALL PRODUCTS

                    <span>
                        ↗
                    </span>

                </a>

            </div>


            <!-- =================================================
                            PRODUCTS SLIDER
            ================================================== -->

            <div class="products-slider">

                <button
                    class="products-arrow products-prev"
                    type="button"
                    aria-label="Previous products"
                >

                    <span>
                        ←
                    </span>

                </button>


                <div class="products-grid">

                    <% products.forEach((product, index) => { %>

                        <article class="product-card">

                            <!-- ================= IMAGE ================= -->

                            <div class="product-image">

                                <img
                                    src="<%= product.Image %>"
                                    alt="<%= product.name %>"
                                    loading="lazy"
                                >


                                <span class="product-number">

                                    <%= String(index + 1).padStart(2, "0") %>

                                </span>


                                <span class="new-badge">
                                    NEW
                                </span>


                                <!-- QUICK VIEW -->

                                <button
                                    class="quick-view"
                                    type="button"
                                    aria-label="Quick view"

                                    data-id="<%= product._id %>"

                                    data-name="<%= product.name %>"

                                    data-price="<%= product.price %>"

                                    data-description="<%= product.description %>"

                                    data-image="<%= product.Image %>"

                                    data-category="<%= product.category || '' %>"

                                    data-s="<%= product.quantity_S || 0 %>"

                                    data-m="<%= product.quantity_M || 0 %>"

                                    data-l="<%= product.quantity_L || 0 %>"

                                    data-xl="<%= product.quantity_XL || 0 %>"

                                    data-2xl="<%= product.quantity_2XL || 0 %>"
                                >

                                    +

                                </button>

                            </div>


                            <!-- ================= INFO ================= -->

                            <div class="product-info">

                                <div class="product-top">

                                    <h2>
                                        <%= product.name %>
                                    </h2>


                                    <span class="price">

                                        <%= product.price %> DA

                                    </span>

                                </div>


                                <p style="font-family: Rubik,sans-serif;">

                                    <%= product.description %>

                                </p>


                                <div class="product-bottom">

                                    <span class="available">

                                        ● AVAILABLE

                                    </span>


                                    <!-- VIEW PRODUCT -->

                                    <button
                                        type="button"
                                        class="product-view"

                                        data-id="<%= product._id %>"

                                        data-name="<%= product.name %>"

                                        data-price="<%= product.price %>"

                                        data-description="<%= product.description %>"

                                        data-image="<%= product.Image %>"

                                        data-category="<%= product.category || '' %>"

                                        data-s="<%= product.quantity_S || 0 %>"

                                        data-m="<%= product.quantity_M || 0 %>"

                                        data-l="<%= product.quantity_L || 0 %>"

                                        data-xl="<%= product.quantity_XL || 0 %>"

                                        data-2xl="<%= product.quantity_2XL || 0 %>"
                                    >

                                        <span>
                                            VIEW PRODUCT
                                        </span>

                                        <strong>
                                            ↗
                                        </strong>

                                    </button>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>


                <button
                    class="products-arrow products-next"
                    type="button"
                    aria-label="Next products"
                >

                    <span>
                        →
                    </span>

                </button>

            </div>

        </section>


        <!-- =====================================================
                         FEEDBACKS
        ====================================================== -->

        <section
            class="feedbacks"
            id="feedbacks"
        >

            <div class="feedbacks-header">

                <span class="feedbacks-label">
                    CUSTOMER FEEDBACK
                </span>


                <h2>

                    WHAT THEY<br>

                    <span>
                        SAY.
                    </span>

                </h2>


                <p>

                    Real words from people who chose
                    Baladi Style.

                </p>

            </div>


            <div class="feedbacks-container">

                <!-- FEEDBACK 1 -->

                <div class="feedback-card">

                    <div class="feedback-top">

                        <div class="feedback-stars">
                            ★★★★★
                        </div>

                        <span class="feedback-number">
                            01
                        </span>

                    </div>


                    <p
                        style="font-family: Rubik,sans-serif;"
                        class="feedback-text"
                    >

                        النوعية تع القماش خير ملي لي توقعت و لحقتني كيما التصويرة ،والله غير ماشاء الله

                    </p>


                    <div class="feedback-user">

                        <span class="feedback-avatar">
                            A
                        </span>

                        <div>

                            <strong>
                                Ahmed
                            </strong>

                            <small>
                                Verified Customer
                            </small>

                        </div>

                    </div>

                </div>


                <!-- FEEDBACK 2 -->

                <div class="feedback-card">

                    <div class="feedback-top">

                        <div class="feedback-stars">
                            ★★★★★
                        </div>

                        <span class="feedback-number">
                            02
                        </span>

                    </div>


                    <p
                        style="font-family: Rubik,sans-serif;"
                        class="feedback-text"
                    >

                        "ستايل شباب بزاف وجودة هايلة. الاونسومبل يبان حطة في الواقع، وعجبني بزاف! بصح ما ندمتش عليه."

                    </p>


                    <div class="feedback-user">

                        <span class="feedback-avatar">
                            S
                        </span>

                        <div>

                            <strong>
                                Samir
                            </strong>

                            <small>
                                Verified Customer
                            </small>

                        </div>

                    </div>

                </div>


                <!-- FEEDBACK 3 -->

                <div class="feedback-card">

                    <div class="feedback-top">

                        <div class="feedback-stars">
                            ★★★★★
                        </div>

                        <span class="feedback-number">
                            03
                        </span>

                    </div>


                    <p
                        style="font-family: Rubik,sans-serif;"
                        class="feedback-text"
                    >

                        شحال من خطرة نشري عليكم و نفس المعاملة الطيبة و الاحترافية ، شكرا

                    </p>


                    <div class="feedback-user">

                        <span class="feedback-avatar">
                            Y
                        </span>

                        <div>

                            <strong>
                                Yanis
                            </strong>

                            <small>
                                Verified Customer
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
                              ABOUT
        ====================================================== -->

        <section
            class="about"
            id="about"
        >

            <div class="about-content">

                <span class="about-label">
                    ABOUT BALADI STYLE
                </span>


                <h2>

                    WEAR YOUR<br>

                    <span>
                        OWN STYLE.
                    </span>

                </h2>


                <p>

                    Baladi Style is more than a clothing store.
                    It is a space for those who see fashion as a way
                    to express who they are.

                </p>


                <p>

                    We bring together carefully selected streetwear pieces,
                    bags and accessories with a focus on style, quality
                    and individuality.

                </p>


                <div class="about-line"></div>


                <span class="about-tagline">

                    STYLE ISN'T FOLLOWED. IT'S CREATED.

                </span>


                <a
                    href="https://www.instagram.com/baladi.style/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="about-instagram"
                >

                    <span class="instagram-icon">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >

                            <rect
                                x="3"
                                y="3"
                                width="18"
                                height="18"
                                rx="5"
                            ></rect>

                            <circle
                                cx="12"
                                cy="12"
                                r="4.2"
                            ></circle>

                            <circle
                                cx="17.5"
                                cy="6.7"
                                r="1"
                            ></circle>

                        </svg>

                    </span>


                    <span>
                        @baladi.style
                    </span>


                    <span class="instagram-arrow">
                        ↗
                    </span>

                </a>

            </div>

        </section>

    </main>


    <!-- =====================================================
                         PRODUCT MODAL
    ====================================================== -->

    <div
        class="product-modal"
        id="productModal"
        aria-hidden="true"
    >

        <div
            class="product-modal-overlay"
            id="modalOverlay"
        ></div>


        <div class="product-modal-box">

            <button
                type="button"
                class="modal-close"
                id="modalClose"
                aria-label="Close"
            >
                ×
            </button>


            <!-- =================================================
                         LEFT PRODUCT
            ================================================== -->

            <div class="modal-product">

                <div class="modal-image">

                    <img
                        id="modalProductImage"
                        src=""
                        alt=""
                    >

                </div>


                <div class="modal-product-info">

                    <span
                        class="modal-category"
                        id="modalProductCategory"
                    ></span>


                    <h2 id="modalProductName"></h2>


                    <div
                        class="modal-price"
                        id="modalProductPrice"
                    ></div>


                    <p id="modalProductDescription"></p>


                    <div
                        class="modal-available"
                        id="modalAvailability"
                    >

                        <span></span>

                        AVAILABLE

                    </div>

                </div>

            </div>


            <!-- =================================================
                              ORDER FORM
            ================================================== -->

            <div class="modal-order">

                <div class="order-header">

                    <span>
                        BALADI STYLE / ORDER
                    </span>


                    <h2>
                        ORDER NOW
                    </h2>


                    <p>

                        Fill in your information and we'll contact
                        you to confirm your order.

                    </p>

                </div>


                <form
                    action="/order"
                    method="POST"
                    id="orderForm"
                >

                    <!-- PRODUCT DATA -->

                    <input
                        type="hidden"
                        name="productId"
                        id="orderProductId"
                    >

                    <input
                        type="hidden"
                        name="productName"
                        id="orderProductName"
                    >

                    <input
                        type="hidden"
                        name="price"
                        id="orderProductPrice"
                    >


                    <!-- DELIVERY DATA -->

                    <input
                        type="hidden"
                        name="deliveryPrice"
                        id="deliveryPrice"
                    >

                    <input
                        type="hidden"
                        name="totalPrice"
                        id="totalPrice"
                    >


                    <!-- FULL NAME -->

                    <div class="order-field">

                        <label>
                            FULL NAME
                        </label>

                        <input
                            type="text"
                            name="name"
                            placeholder="Your full name"
                            autocomplete="name"
                            required
                        >

                    </div>


                    <!-- PHONE -->

                    <div class="order-field">

                        <label>
                            PHONE NUMBER
                        </label>

                        <input
                            type="tel"
                            name="phone"
                            placeholder="05 XX XX XX XX"
                            autocomplete="tel"
                            required
                        >

                    </div>


                    <!-- WILAYA -->

                    <div class="order-field">

                        <label>
                            WILAYA
                        </label>

                        <select
                            name="wilaya"
                            id="wilaya"
                            required
                        >

                            <option
                                value=""
                                disabled
                                selected
                            >
                                Select your wilaya
                            </option>

                            <option value="Adrar">
                                01 - Adrar
                            </option>

                            <option value="Chlef">
                                02 - Chlef
                            </option>

                            <option value="Laghouat">
                                03 - Laghouat
                            </option>

                            <option value="Oum El Bouaghi">
                                04 - Oum El Bouaghi
                            </option>

                            <option value="Batna">
                                05 - Batna
                            </option>

                            <option value="Béjaïa">
                                06 - Béjaïa
                            </option>

                            <option value="Biskra">
                                07 - Biskra
                            </option>

                            <option value="Béchar">
                                08 - Béchar
                            </option>

                            <option value="Blida">
                                09 - Blida
                            </option>

                            <option value="Bouira">
                                10 - Bouira
                            </option>

                            <option value="Tamanrasset">
                                11 - Tamanrasset
                            </option>

                            <option value="Tébessa">
                                12 - Tébessa
                            </option>

                            <option value="Tlemcen">
                                13 - Tlemcen
                            </option>

                            <option value="Tiaret">
                                14 - Tiaret
                            </option>

                            <option value="Tizi Ouzou">
                                15 - Tizi Ouzou
                            </option>

                            <option value="Alger">
                                16 - Alger
                            </option>

                            <option value="Djelfa">
                                17 - Djelfa
                            </option>

                            <option value="Jijel">
                                18 - Jijel
                            </option>

                            <option value="Sétif">
                                19 - Sétif
                            </option>

                            <option value="Saïda">
                                20 - Saïda
                            </option>

                            <option value="Skikda">
                                21 - Skikda
                            </option>

                            <option value="Sidi Bel Abbès">
                                22 - Sidi Bel Abbès
                            </option>

                            <option value="Annaba">
                                23 - Annaba
                            </option>

                            <option value="Guelma">
                                24 - Guelma
                            </option>

                            <option value="Constantine">
                                25 - Constantine
                            </option>

                            <option value="Médéa">
                                26 - Médéa
                            </option>

                            <option value="Mostaganem">
                                27 - Mostaganem
                            </option>

                            <option value="M'Sila">
                                28 - M'Sila
                            </option>

                            <option value="Mascara">
                                29 - Mascara
                            </option>

                            <option value="Ouargla">
                                30 - Ouargla
                            </option>

                            <option value="Oran">
                                31 - Oran
                            </option>

                            <option value="El Bayadh">
                                32 - El Bayadh
                            </option>

                            <option value="Illizi">
                                33 - Illizi
                            </option>

                            <option value="Bordj Bou Arreridj">
                                34 - Bordj Bou Arreridj
                            </option>

                            <option value="Boumerdès">
                                35 - Boumerdès
                            </option>

                            <option value="El Tarf">
                                36 - El Tarf
                            </option>

                            <option value="Tindouf">
                                37 - Tindouf
                            </option>

                            <option value="Tissemsilt">
                                38 - Tissemsilt
                            </option>

                            <option value="El Oued">
                                39 - El Oued
                            </option>

                            <option value="Khenchela">
                                40 - Khenchela
                            </option>

                            <option value="Souk Ahras">
                                41 - Souk Ahras
                            </option>

                            <option value="Tipaza">
                                42 - Tipaza
                            </option>

                            <option value="Mila">
                                43 - Mila
                            </option>

                            <option value="Aïn Defla">
                                44 - Aïn Defla
                            </option>

                            <option value="Naâma">
                                45 - Naâma
                            </option>

                            <option value="Aïn Témouchent">
                                46 - Aïn Témouchent
                            </option>

                            <option value="Ghardaïa">
                                47 - Ghardaïa
                            </option>

                            <option value="Relizane">
                                48 - Relizane
                            </option>

                            <option value="Timimoun">
                                49 - Timimoun
                            </option>

                            <option value="Ouled Djellal">
                                51 - Ouled Djellal
                            </option>

                            <option value="Beni Abbes">
                                52 - Beni Abbes
                            </option>

                            <option value="In Salah">
                                53 - In Salah
                            </option>

                            <option value="Touggourt">
                                55 - Touggourt
                            </option>

                            <option value="El M'Ghair">
                                57 - El M'Ghair
                            </option>

                            <option value="El Meniaa">
                                58 - El Meniaa
                            </option>

                        </select>

                    </div>


                    <!-- COMMUNE -->

                    <div class="order-field">

                        <label>
                            COMMUNE(Baladia)
                        </label>

                        <input
                            type="text"
                            name="commune"
                            id="commune"
                            placeholder="Your commune"
                            required
                        >

                    </div>


                    <!-- DELIVERY METHOD -->

                    <div class="order-field">

                        <label>
                            DELIVERY METHOD
                        </label>


                        <div class="delivery-options">

                            <label class="delivery-option">

                                <input
                                    type="radio"
                                    name="deliveryMethod"
                                    value="Home Delivery"
                                    id="homeDelivery"
                                    required
                                >

                                <div>

                                    <strong>
                                        HOME DELIVERY
                                    </strong>

                                    <small>
                                        Delivery to your address
                                    </small>

                                </div>

                            </label>


                            <label class="delivery-option">

                                <input
                                    type="radio"
                                    name="deliveryMethod"
                                    value="Stop Desk"
                                    id="stopDesk"
                                >

                                <div>

                                    <strong>
                                        STOP DESK
                                    </strong>

                                    <small>
                                        Pick up from delivery office
                                    </small>

                                </div>

                            </label>

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div
                        class="order-field"
                        id="addressField"
                        style="display: none;"
                    >

                        <label>
                            DELIVERY ADDRESS
                        </label>

                        <input
                            type="text"
                            name="address"
                            id="address"
                            placeholder="Your full delivery address"
                            autocomplete="street-address"
                        >

                    </div>


                    <!-- SIZE -->

                    <div class="order-field">

                        <label>
                            SIZE
                        </label>


                        <div class="size-options">

                            <label
                                class="size-option"
                                id="sizeS"
                            >

                                <input
                                    type="radio"
                                    name="size"
                                    value="S"
                                    required
                                >

                                <span>
                                    S
                                </span>

                                <small>
                                    AVAILABLE
                                </small>

                            </label>


                            <label
                                class="size-option"
                                id="sizeM"
                            >

                                <input
                                    type="radio"
                                    name="size"
                                    value="M"
                                >

                                <span>
                                    M
                                </span>

                                <small>
                                    AVAILABLE
                                </small>

                            </label>


                            <label
                                class="size-option"
                                id="sizeL"
                            >

                                <input
                                    type="radio"
                                    name="size"
                                    value="L"
                                >

                                <span>
                                    L
                                </span>

                                <small>
                                    AVAILABLE
                                </small>

                            </label>


                            <label
                                class="size-option"
                                id="sizeXL"
                            >

                                <input
                                    type="radio"
                                    name="size"
                                    value="XL"
                                >

                                <span>
                                    XL
                                </span>

                                <small>
                                    AVAILABLE
                                </small>

                            </label>


                            <!-- ================= 2XL ================= -->

                            <label
                                class="size-option"
                                id="size2XL"
                            >

                                <input
                                    type="radio"
                                    name="size"
                                    value="2XL"
                                >

                                <span>
                                    2XL
                                </span>

                                <small>
                                    AVAILABLE
                                </small>

                            </label>

                        </div>

                    </div>


                    <!-- QUANTITY -->

                    <div class="order-field">

                        <label>
                            QUANTITY
                        </label>

                        <input
                            type="number"
                            name="quantity"
                            id="orderQuantity"
                            value="0"
                            required
                        >

                    </div>


                    <!-- PRICE SUMMARY -->

                    <div class="price-summary">

                        <div class="price-row">

                            <span>
                                PRODUCT
                            </span>

                            <strong>

                                <span id="productTotal">
                                    0
                                </span>

                                DA

                            </strong>

                        </div>


                        <div class="price-row">

                            <span>
                                DELIVERY
                            </span>

                            <strong>

                                <span id="deliveryTotal">
                                    0
                                </span>

                                DA

                            </strong>

                        </div>


                        <div class="price-row total-row">

                            <span>
                                TOTAL
