        const wilayaInput =
            document.getElementById("wilaya");

        const quantityInput =
            document.getElementById("orderQuantity");

        const addressField =
            document.getElementById("addressField");

        const addressInput =
            document.getElementById("address");

        const productPriceInput =
            document.getElementById("orderProductPrice");

        const deliveryPriceInput =
            document.getElementById("deliveryPrice");

        const totalPriceInput =
            document.getElementById("totalPrice");

        const productTotal =
            document.getElementById("productTotal");

        const deliveryTotal =
            document.getElementById("deliveryTotal");

        const orderTotal =
            document.getElementById("orderTotal");


        /* =====================================================
                       GET DELIVERY PRICE
        ====================================================== */

        function getDeliveryPrice() {

            const wilaya =
                wilayaInput.value;


            const selectedMethod =
                document.querySelector(
                    'input[name="deliveryMethod"]:checked'
                );


            if (
                !wilaya ||
                !selectedMethod
            ) {

                return 0;

            }


            const data =
                deliveryPrices[wilaya];


            if (!data) {

                return 0;

            }


            if (
                selectedMethod.value ===
                "Home Delivery"
            ) {

                return data.home;

            }


            if (
                selectedMethod.value ===
                "Stop Desk"
            ) {

                return data.stopDesk;

            }


            return 0;

        }


        /* =====================================================
                           UPDATE TOTAL
        ====================================================== */

        function updateTotal() {

            const price =
                parseFloat(
                    productPriceInput.value
                ) || 0;


            const quantity =
                parseInt(
                    quantityInput.value
                ) || 1;


            const delivery =
                getDeliveryPrice();


            const subtotal =
                price * quantity;


            const total =
                subtotal + delivery;


            productTotal.textContent =
                subtotal.toLocaleString(
                    "fr-DZ"
                );


            deliveryTotal.textContent =
                delivery.toLocaleString(
                    "fr-DZ"
                );


            orderTotal.textContent =
                total.toLocaleString(
                    "fr-DZ"
                );


            deliveryPriceInput.value =
                delivery;


            totalPriceInput.value =
                total;

        }


        /* =====================================================
                       DELIVERY METHOD
        ====================================================== */

        document
            .querySelectorAll(
                'input[name="deliveryMethod"]'
            )
            .forEach(
                function (radio) {

                    radio.addEventListener(
                        "change",
                        function () {

                            if (
                                this.value ===
                                "Home Delivery"
                            ) {

                                addressField.style.display =
                                    "block";


                                addressInput.required =
                                    true;

                            } else {

                                addressField.style.display =
                                    "none";


                                addressInput.required =
                                    false;


                                addressInput.value =
                                    "";

                            }


                            updateTotal();

                        }
                    );

                }
            );


        /* =====================================================
                         WILAYA CHANGE
        ====================================================== */

        wilayaInput.addEventListener(
            "change",
            updateTotal
        );


        /* =====================================================
                        QUANTITY CHANGE
        ====================================================== */

        quantityInput.addEventListener(
            "input",
            updateTotal
        );


        /* =====================================================
                       FORM VALIDATION
        ====================================================== */

        document
            .getElementById("orderForm")
            .addEventListener(
                "submit",
                event => {

                    const selected =
                        document.querySelector(
                            'input[name="size"]:checked'
                        );


                    if (!selected) {

                        event.preventDefault();

                        alert(
                            "Please select a size."
                        );

                        return;

                    }


                    const size =
                        selected.value;


                    const quantity =
                        Number(
                            orderQuantity.value
                        );


                    const stock =
                        currentStock[size];


                    if (
                        quantity < 1 ||
                        quantity > stock
                    ) {

                        event.preventDefault();

                        alert(
                            "The selected quantity is not available."
                        );

                        return;

                    }


                    updateTotal();

                }
            );


        /* =====================================================
                          MOBILE MENU
        ====================================================== */

        const menu =
            document.getElementById("menu");

        const hamburger =
            document.getElementById("hamburger");

        const image =
            document.getElementById("close");


        let number = 0;


        menu.addEventListener(
            "click",
            function () {

                hamburger.classList.toggle(
                    "active"
                );


                if (number === 0) {

                    image.src =
                        "close.svg";

                    number += 1;

                } else {

                    image.src =
                        "menu.svg";

                    number = 0;

                }

            }
        );


