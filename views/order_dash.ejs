<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Orders | Baladi Style</title>

    <link rel="stylesheet" href="/orders.css">

</head>


<body>


    <!-- =========================================
         EXISTING SIDEBAR
    ========================================== -->

    <%- include('slidebar') %>



    <!-- =========================================
         ORDERS
    ========================================== -->

    <main class="orders-container">


        <!-- HEADER -->

        <div class="orders-header">

            <div>

                <span class="page-label">
                    DASHBOARD
                </span>

                <h1>
                    Orders
                </h1>

            </div>


            <div class="orders-count">

                <span>
                    TOTAL ORDERS
                </span>

                <strong>
                    <%= orders.length %>
                </strong>

            </div>

        </div>



        <!-- =====================================
             ORDERS LIST
        ====================================== -->

        <% if (orders && orders.length > 0) { %>


            <div class="orders-list">


                <% orders.forEach((order, index) => { %>


                    <div class="order">


                        <!-- ORDER NUMBER -->

                        <div class="order-number">

                            #<%= String(index + 1).padStart(2, '0') %>

                        </div>



                        <!-- ORDER INFORMATION -->

                        <div class="order-info">


                            <!-- PRODUCT -->

                            <div class="order-item">

                                <span>
                                    PRODUCT
                                </span>

                                <strong>
                                    <%= order.productName %>
                                </strong>

                            </div>



                            <!-- CUSTOMER -->

                            <div class="order-item">

                                <span>
                                    CUSTOMER
                                </span>

                                <strong>
                                    <%= order.name %>
                                </strong>

                            </div>



                            <!-- PHONE -->

                            <div class="order-item">

                                <span>
                                    PHONE
                                </span>

                                <strong>
                                    <%= order.phone %>
                                </strong>

                            </div>



                            <!-- SIZE -->

                            <div class="order-item">

                                <span>
                                    SIZE
                                </span>

                                <strong class="size-value">
                                    <%= order.size %>
                                </strong>

                            </div>



                            <!-- QUANTITY -->

                            <div class="order-item">

                                <span>
                                    QTY
                                </span>

                                <strong>
                                    <%= order.quantity %>
                                </strong>

                            </div>



                            <!-- ADDRESS -->

                            <div class="order-item address-item">

                                <span>
                                    ADDRESS
                                </span>

                                <strong>
                                    <%= order.address %>
                                </strong>

                            </div>


                        </div>



                        <!-- DELETE -->

                        <form
                            class="delete-form"
                            action="/dashboard/delete_order/<%= order._id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this order?');"
                        >

                            <button
                                type="submit"
                                class="delete-order"
                            >

                                DELETE

                            </button>

                        </form>


                    </div>


                <% }) %>


            </div>


        <% } else { %>


            <!-- =================================
                 NO ORDERS
            ================================== -->

            <div class="no-orders">

                <div class="empty-icon">
                    —
                </div>

                <h2>
                    No Orders Yet
                </h2>

                <p>
                    Orders placed by customers will appear here.
                </p>

            </div>


        <% } %>


    </main>


</body>

</html>